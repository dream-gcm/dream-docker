# Start from the Jupyter base notebook image
FROM quay.io/jupyter/scipy-notebook:2024-10-07

# Switch to root to install system-level dependencies
USER root

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gfortran \
    libhdf5-dev \
    libnetcdf-dev \
    libnetcdff-dev \
    netcdf-bin \
    tcsh \
    ksh \
    vim \
    && rm -rf /var/lib/apt/lists/*

# Switch back to jovyan user (the default user in Jupyter images)
USER ${NB_UID}

# Install CDO and NCO in a separate conda environment
RUN mamba create -y -n cdo-env -c conda-forge cdo nco \
    && mamba clean --all -f -y \
    && fix-permissions "${CONDA_DIR}" \
    && fix-permissions "/home/${NB_USER}"

# Make cdo/nco available, with the base environment still taking priority
ENV PATH="${PATH}:/opt/conda/envs/cdo-env/bin"

# Install Python packages using pip
RUN pip install --no-cache-dir \
    cartopy \
    numpy \
    netCDF4 \
    pandas \
    matplotlib \
    scipy \
    xarray \
    Pillow \
    ffmpeg-python

# Expose the JupyterLab port
EXPOSE 8888

# Set the default command to start JupyterLab
CMD ["jupyter", "lab", "--ip=0.0.0.0", "--no-browser"]
